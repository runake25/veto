# Copy to .env and fill in. .env is gitignored; never commit real keys.

# PayPal REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# 1 = talk to the real sandbox, 0 = use the in-process mock
PAYPAL_LIVE=1

# DeepSeek (item extraction only; never prices, vendors or payees)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com

# Channel3 product catalogue (trychannel3.com). Used as the agent's search.
CHANNEL3_API_KEY=
CHANNEL3_COUNTRY=US
CHANNEL3_CURRENCY=USD

# Slack app (api.slack.com/apps → your app → Basic Information / Interactivity)
# Leave blank to run the slash command from curl only.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Public https URL of the runner while Slack points at this machine.
# python3 slack/link.py uses it to build the one-click app install link.
VETO_PUBLIC_URL=
